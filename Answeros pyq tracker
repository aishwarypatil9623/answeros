<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>AnswerOS — PYQ Tracker</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --green-900:#14532d; --green-800:#1c5c30; --green-700:#1f7a3d; --green-600:#2c8a46;
    --green-100:#e6f4ea; --green-50:#f3faf5;
    --ink-900:#14171a; --ink-700:#3c4247; --ink-500:#6b7278; --ink-300:#a2a8ad;
    --line:#e7eae8; --bg:#f6f8f6; --card:#ffffff;
    --red:#b3402c; --red-50:#fbf1ee; --amber:#c98a1f; --amber-50:#fbf5e8;
    --blue:#3b6fd5; --purple:#7a4fd5;
    --shadow: 0 1px 2px rgba(20,23,26,0.04), 0 6px 20px rgba(20,23,26,0.05);
    --radius: 14px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg);color:var(--ink-900);font-family:"Inter","Segoe UI",-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;-webkit-font-smoothing:antialiased;}
  .serif{font-family:"Source Serif 4",Georgia,serif;}
  .app{display:grid;grid-template-columns:232px 1fr;min-height:100vh;min-width:1180px;}

  .sidebar{background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;padding:22px 16px;position:sticky;top:0;height:100vh;}
  .brand{display:flex;align-items:center;gap:10px;padding:2px 8px 22px 8px;}
  .brand-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(155deg,var(--green-600),var(--green-900));display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;box-shadow:var(--shadow);}
  .brand-text .name{font-weight:700;font-size:15px;letter-spacing:-0.02em;color:var(--ink-900);line-height:1.1;}
  .brand-text .sub{font-size:11px;color:var(--ink-500);margin-top:2px;}
  nav{display:flex;flex-direction:column;gap:2px;margin-top:6px;}
  .nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;color:var(--ink-700);font-size:13.5px;font-weight:500;cursor:pointer;user-select:none;transition:background .12s ease,color .12s ease;}
  .nav-item svg{width:16px;height:16px;flex-shrink:0;opacity:.75;}
  .nav-item:hover{background:var(--green-50);color:var(--green-800);}
  .nav-item.active{background:var(--green-100);color:var(--green-800);font-weight:600;}
  .nav-item.active svg{opacity:1;}
  .nav-spacer{flex:1;}
  .side-foot{border-top:1px solid var(--line);padding-top:14px;margin-top:10px;}
  .user-row{display:flex;align-items:center;gap:10px;padding:6px 8px;}
  .avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(140deg,#f0b7c4,#e08fa6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;}
  .user-row .uname{font-weight:600;font-size:12.5px;}
  .user-row .urole{font-size:11px;color:var(--ink-500);}
  .quote-card{margin-top:12px;background:var(--green-900);color:#e9f5ec;border-radius:12px;padding:14px;font-size:12px;line-height:1.55;}
  .quote-card .mark{font-size:20px;opacity:.5;line-height:0;display:block;margin-bottom:2px;}
  .quote-card .attrib{margin-top:8px;font-size:10.5px;color:#a9d3b4;}

  main{padding:22px 30px 60px 30px;max-width:1760px;}
  .pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:6px;}
  .pagehead h1{font-size:22px;margin:0 0 4px 0;letter-spacing:-0.02em;}
  .pagehead p{margin:0;color:var(--ink-500);font-size:12.5px;}
  .note-banner{background:var(--amber-50);border:1px solid #e7dcc0;border-radius:10px;padding:10px 14px;font-size:11.5px;color:#5c470f;line-height:1.5;margin:14px 0 18px 0;}

  .ministat-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;}
  .ministat{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:10px 16px;box-shadow:var(--shadow);min-width:130px;}
  .ministat .mv{font-size:18px;font-weight:800;letter-spacing:-0.02em;}
  .ministat .ml{font-size:10.5px;color:var(--ink-500);margin-top:1px;}
  .ministat.due .mv{color:var(--red);}

  /* ---- Due for revision strip ---- */
  .due-strip{background:linear-gradient(120deg,var(--green-900),var(--green-800));border-radius:var(--radius);padding:16px 20px;margin-bottom:22px;color:#eaf6ee;}
  .due-strip-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .due-strip-head h3{margin:0;font-size:13.5px;font-weight:700;display:flex;align-items:center;gap:7px;}
  .due-list{display:flex;gap:10px;flex-wrap:wrap;}
  .due-chip{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:9px;padding:8px 12px;font-size:11.5px;display:flex;align-items:center;gap:8px;cursor:pointer;transition:background .12s ease;}
  .due-chip:hover{background:rgba(255,255,255,.18);}
  .due-chip .dpaper{font-weight:700;background:rgba(255,255,255,.15);padding:2px 6px;border-radius:5px;}
  .due-empty{font-size:12px;color:#bfe6cb;}

  /* ---- Frequency heatmap ---- */
  .heatmap-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px 20px;margin-bottom:22px;}
  .heatmap-card .hc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
  .heatmap-card h3{margin:0;font-size:14px;}
  .heatmap-card .hc-sub{font-size:11.5px;color:var(--ink-500);margin-bottom:14px;}
  table.heat{width:100%;border-collapse:collapse;}
  table.heat th{font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;color:var(--ink-500);text-align:left;padding:6px 10px;border-bottom:1px solid var(--line);}
  table.heat th.center, table.heat td.center{text-align:center;}
  table.heat td{padding:8px 10px;font-size:12.5px;border-bottom:1px solid #f0f2f0;}
  .heat-cell{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;font-weight:700;font-size:11.5px;}
  .topic-row-name{font-weight:600;}
  .topic-row-cluster{font-size:10.5px;color:var(--ink-500);}

  .toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px;position:sticky;top:0;background:var(--bg);padding:10px 0;z-index:5;}
  .search-wrap{position:relative;flex:1;min-width:220px;max-width:340px;}
  .search-wrap svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--ink-300);}
  .search-wrap input{width:100%;padding:9px 12px 9px 34px;border-radius:10px;border:1px solid var(--line);background:#fff;font-size:13px;font-family:inherit;outline:none;}
  .search-wrap input:focus{border-color:var(--green-600);box-shadow:0 0 0 3px var(--green-100);}
  .chips{display:flex;gap:6px;flex-wrap:wrap;}
  .chip{padding:7px 13px;border-radius:20px;border:1px solid var(--line);background:#fff;font-size:12px;font-weight:600;color:var(--ink-700);cursor:pointer;user-select:none;}
  .chip:hover{border-color:var(--green-600);}
  .chip.active{background:var(--green-800);border-color:var(--green-800);color:#fff;}
  .toolbar-spacer{flex:1;}
  select.sortsel{padding:8px 12px;border-radius:10px;border:1px solid var(--line);background:#fff;font-size:12.5px;font-family:inherit;color:var(--ink-700);cursor:pointer;outline:none;}

  #list{display:flex;flex-direction:column;gap:12px;}
  .pcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px 20px;}
  .pcard-top{display:flex;align-items:flex-start;gap:14px;}
  .ptag{font-size:11px;font-weight:800;border-radius:7px;padding:5px 10px;flex-shrink:0;}
  .yeartag{font-size:11px;font-weight:700;color:var(--ink-500);background:#f0f2ee;border-radius:7px;padding:5px 9px;flex-shrink:0;}
  .pq-main{flex:1;min-width:0;}
  .pq-question{font-size:14.5px;line-height:1.5;color:var(--ink-900);}
  .pq-meta{display:flex;gap:10px;align-items:center;margin-top:8px;flex-wrap:wrap;font-size:11px;color:var(--ink-500);}
  .freq-badge{background:var(--amber-50);color:#8a6212;border:1px solid #e7dcc0;border-radius:20px;padding:3px 9px;font-weight:700;font-size:10.5px;}
  .marks-badge{color:var(--ink-500);}

  .pq-controls{display:flex;align-items:center;gap:14px;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);flex-wrap:wrap;}
  .attempt-toggle{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;cursor:pointer;user-select:none;color:var(--ink-700);}
  .attempt-toggle input{width:15px;height:15px;accent-color:var(--green-700);cursor:pointer;}
  .stars{display:flex;gap:2px;}
  .star{width:15px;height:15px;cursor:pointer;color:var(--ink-300);}
  .star.filled{color:var(--amber);}
  .revision-info{margin-left:auto;font-size:11.5px;color:var(--ink-500);display:flex;align-items:center;gap:8px;}
  .revision-info.overdue{color:var(--red);font-weight:600;}
  .revision-info.due-today{color:#8a6212;font-weight:600;}
  .revise-btn{background:var(--green-800);color:#fff;border:none;border-radius:8px;padding:6px 11px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;}
  .revise-btn:hover{background:var(--green-900);}
  .revise-btn:disabled{background:#d6dcd7;cursor:default;}

  .empty-state{background:var(--card);border:1px dashed var(--line);border-radius:var(--radius);padding:50px 20px;text-align:center;color:var(--ink-500);font-size:13px;}
  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-thumb{background:#d7dcd8;border-radius:8px;}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">🌱</div>
      <div class="brand-text"><div class="name">AnswerOS</div><div class="sub">Answer Writing Tracker</div></div>
    </div>
    <nav id="nav"></nav>
    <div class="nav-spacer"></div>
    <div class="side-foot">
      <div class="user-row">
        <div class="avatar">AP</div>
        <div><div class="uname">Aishwary Patil</div><div class="urole">UPSC Aspirant 🎯</div></div>
      </div>
      <div class="quote-card">
        <span class="mark">"</span>
        Rankers aren't the ones who read the most — they're the ones who revise the recurring themes till they're reflexes.
        <div class="attrib">— Examiner's Note</div>
      </div>
    </div>
  </aside>

  <main>
    <div class="pagehead">
      <div>
        <h1>PYQ Tracker</h1>
        <p>Previous Year Questions — mapped to your subjects, ranked by how often they recur.</p>
      </div>
    </div>
    <div class="note-banner">⚠️ This tracker runs on a starter set of <b>16 verified UPSC Mains PYQs</b> (2019–2024, cross-checked against official papers and standard compilations) — not your Google Sheet, which doesn't track PYQs yet. Attempt/confidence/revision state here resets each session (no PYQ columns to sync to). Once you're ready, add a PYQ tab to your sheet and I'll wire this to sync like the other pages.</div>

    <div class="ministat-row" id="ministats"></div>

    <div class="due-strip">
      <div class="due-strip-head">
        <h3>🔔 Due for Revision</h3>
        <span style="font-size:11px;color:#bfe6cb;" id="dueCount"></span>
      </div>
      <div class="due-list" id="dueList"></div>
    </div>

    <div class="heatmap-card">
      <div class="hc-head"><h3>Repetition Heatmap — where UPSC keeps coming back</h3></div>
      <div class="hc-sub">How often each recurring theme has appeared in Mains GS papers, 2019–2024. Darker = higher priority for revision.</div>
      <table class="heat" id="heatTable"></table>
    </div>

    <div class="toolbar">
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" id="searchBox" placeholder="Search question or topic…" />
      </div>
      <div class="chips" id="paperChips"></div>
      <div class="toolbar-spacer"></div>
      <select class="sortsel" id="sortSel">
        <option value="year-desc">Newest year first</option>
        <option value="year-asc">Oldest year first</option>
        <option value="freq-desc">Most recurring first</option>
        <option value="due-first">Due for revision first</option>
      </select>
    </div>

    <div id="list"></div>
    <div id="emptyState" class="empty-state" style="display:none;">No PYQs match this filter.</div>
  </main>
</div>

<script>
/* ============================================================
   PYQ DATA — verified UPSC Mains previous-year questions.
   Topic clusters aligned to Aishwary's own subject taxonomy
   (matches the Subject field used in his Mains Tracker sheet).
   Source-checked against official UPSC papers / standard
   compilations (2024 GS1 wording confirmed against the
   released question paper; 2021 GS2 judiciary question
   cross-checked across multiple independent PYQ archives).
============================================================ */
const PYQS = [
  {year:2024, paper:"GS1", marks:10, topic:"Ancient & Vedic Society", cluster:"Modern Indian History",
   question:"Underline the changes in the field of society and economy from the Rig Vedic to the later Vedic period."},
  {year:2021, paper:"GS1", marks:10, topic:"Gandhi & Freedom Struggle", cluster:"Modern Indian History",
   question:"Discuss the main contributions of Gandhi in South Africa to the emancipation of Indians."},
  {year:2020, paper:"GS1", marks:15, topic:"Physical Geography", cluster:"Geography",
   question:"Discuss the geophysical characteristics of the Circum-Pacific Zone."},
  {year:2019, paper:"GS1", marks:15, topic:"Social Reform Movements", cluster:"Modern Indian History",
   question:"The women's questions arose in modern India as a part of the 19th century social reform movement. What were the major issues and debates concerning women in that period?"},

  {year:2021, paper:"GS2", marks:10, topic:"Judicial Representation", cluster:"Polity and Governance",
   question:"Discuss the desirability of greater representation to women in the higher judiciary to ensure diversity, equity and inclusiveness."},
  {year:2021, paper:"GS2", marks:15, topic:"Centre-State Fiscal Relations", cluster:"Polity and Governance",
   question:"Discuss the recommendations of the 15th Finance Commission which have been a departure from the previous commissions, for the distribution of resources between the Centre and the States."},
  {year:2020, paper:"GS2", marks:15, topic:"Tribal Rights & Sixth Schedule", cluster:"Polity and Governance",
   question:"Discuss the role of the Sixth Schedule in the protection of tribal rights in the Indian Constitution."},
  {year:2019, paper:"GS2", marks:15, topic:"Governor's Powers", cluster:"Polity and Governance",
   question:"Discuss the essential conditions for exercise of the legislative powers by the Governor. Discuss the legality of re-promulgation of ordinances by the Governor without placing them before the Legislature."},

  {year:2021, paper:"GS3", marks:15, topic:"Defence Technology", cluster:"Science and Technology",
   question:"How is the S-400 air defence system technically superior to any other system presently available in the world?"},
  {year:2020, paper:"GS3", marks:15, topic:"Inclusive Growth", cluster:"Economy",
   question:"What are the salient features of 'inclusive growth'? Has India been experiencing such a growth process? Analyze and suggest measures for inclusive growth."},
  {year:2019, paper:"GS3", marks:15, topic:"Urbanisation & Social Problems", cluster:"Economy",
   question:"Discuss the various social problems which originated out of the speedy process of urbanization in India."},
  {year:2018, paper:"GS3", marks:15, topic:"Industrial Policy", cluster:"Economy",
   question:"'Industrial growth rate has lagged behind in the overall growth of Gross Domestic Product (GDP) in the post-reform period.' Give reasons. How far the recent changes in Industrial Policy are capable of increasing the industrial growth rate?"},

  {year:2020, paper:"GS4", marks:10, topic:"Accountability & Responsibility", cluster:"Ethics",
   question:"What is meant by 'accountability' and 'responsibility' in ethics? What are the implications of holding an office bearer accountable? Illustrate with the help of a suitable case."},
  {year:2019, paper:"GS4", marks:10, topic:"Corruption & Core Values", cluster:"Ethics",
   question:"'Corruption is the manifestation of the failure of core values in the society.' In the light of the above statement, mention the measures that need to be adopted to uplift the core values in society."},
  {year:2018, paper:"GS4", marks:10, topic:"Ethics in Education", cluster:"Ethics",
   question:"'Ethical training in higher educational institutions is a sine qua non for reasoned, effective and ethically sustained governance, politics and public administration.' Discuss."},

  {year:2021, paper:"PSIR", marks:10, topic:"Human Rights Institutions", cluster:"PSIR",
   question:"Critically examine the National Human Rights Commission Act, 1993 in the backdrop of the Paris Principles."},
];
PYQS.forEach((p,i)=>{ p.id = p.year+'_'+p.paper+'_'+i; p.attempted=false; p.confidence=0; p.nextDue=null; p.lastRevised=null; });

const PAPER_COLORS = {GS1:'#3b6fd5', GS2:'#2c8a46', GS3:'#7a4fd5', GS4:'#e0762c', PSIR:'#22a3a3', Essay:'#c98a1f'};

/* ---------- nav ---------- */
function navIcon(name){
  const p = {
    grid:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
    bar:'<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/>',
    archive:'<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8M10 13h4"/>',
    book:'<path d="M4 4.5A2.5 2.5 0 016.5 2H20v18H6.5A2.5 2.5 0 004 17.5v-13z"/><path d="M4 17.5A2.5 2.5 0 016.5 15H20"/>',
    refresh:'<path d="M21 12a9 9 0 11-3-6.7"/><path d="M21 3v6h-6"/>',
    layers:'<path d="M12 2l9 5-9 5-9-5 9-5z"/><path d="M3 12l9 5 9-5M3 17l9 5 9-5"/>',
    cal2:'<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    flag:'<path d="M5 3v18"/><path d="M5 4h13l-3 4 3 4H5"/>',
    gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1-1.6 1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1 1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"/>'
  };
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p[name]}</svg>`;
}
document.getElementById('nav').innerHTML = [
  ['Dashboard','grid','answeros-dashboard.html'],['All Answers','list','answeros-all-answers.html'],['Analytics','bar'],
  ['PYQ Tracker','archive','answeros-pyq-tracker.html',true],['Learnings','book'],['Revision Hub','refresh'],['Flashcards','layers'],
  ['Calendar','cal2'],['Goals','flag'],['Settings','gear']
].map(([label,ic,href,active])=> href
    ? `<a href="${href}" class="nav-item ${active?'active':''}" style="text-decoration:none;">${navIcon(ic)}<span>${label}</span></a>`
    : `<div class="nav-item" style="opacity:.55;cursor:default;">${navIcon(ic)}<span>${label}</span></div>`
).join('');

/* ---------- spaced revision logic (simple Leitner-style) ---------- */
function scheduleInterval(confidence){
  if(confidence<=2) return 3;
  if(confidence===3) return 7;
  return 21;
}
function todayStr(){ return new Date().toISOString().slice(0,10); }
function addDays(dateStr, days){
  const d = new Date(dateStr); d.setDate(d.getDate()+days); return d.toISOString().slice(0,10);
}
function dueStatus(p){
  if(!p.attempted || !p.nextDue) return 'none';
  const today = todayStr();
  if(p.nextDue < today) return 'overdue';
  if(p.nextDue === today) return 'due-today';
  return 'scheduled';
}

/* ---------- frequency (topic clusters recurring across years) ---------- */
const clusterFreq = {};
PYQS.forEach(p=>{ clusterFreq[p.cluster] = (clusterFreq[p.cluster]||0)+1; });
function freqLabel(p){
  const n = clusterFreq[p.cluster];
  if(n>=3) return `Recurring — ${p.cluster} asked ${n}× since 2018`;
  return null;
}

/* ---------- heatmap ---------- */
function renderHeatmap(){
  const years = [...new Set(PYQS.map(p=>p.year))].sort((a,b)=>b-a);
  const clusters = [...new Set(PYQS.map(p=>p.cluster))];
  let html = '<tr><th>Theme</th>' + years.map(y=>`<th class="center">${y}</th>`).join('') + '<th class="center">Total</th></tr>';
  clusters.forEach(c=>{
    const rows = PYQS.filter(p=>p.cluster===c);
    html += `<tr><td><div class="topic-row-name">${c}</div></td>`;
    years.forEach(y=>{
      const count = rows.filter(p=>p.year===y).length;
      const bg = count===0?'transparent':count===1?'#cdeada':'#7cc298';
      const fg = count===0?'var(--ink-300)':count===1?'#1c5c30':'#fff';
      html += `<td class="center"><span class="heat-cell" style="background:${bg};color:${fg};">${count||'·'}</span></td>`;
    });
    html += `<td class="center"><b>${rows.length}</b></td></tr>`;
  });
  document.getElementById('heatTable').innerHTML = html;
}
renderHeatmap();

/* ---------- filters/search/sort state ---------- */
let activePaper = 'All';
let searchTerm = '';
const papersPresent = [...new Set(PYQS.map(p=>p.paper))];
document.getElementById('paperChips').innerHTML = ['All', ...papersPresent].map(p=>
  `<div class="chip ${p==='All'?'active':''}" data-paper="${p}">${p}</div>`
).join('');
document.getElementById('paperChips').addEventListener('click', e=>{
  const chip = e.target.closest('.chip'); if(!chip) return;
  activePaper = chip.dataset.paper;
  document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('active', c===chip));
  render();
});
document.getElementById('searchBox').addEventListener('input', e=>{ searchTerm = e.target.value.toLowerCase(); render(); });
document.getElementById('sortSel').addEventListener('change', render);

function render(){
  renderMiniStats();
  renderDueStrip();

  let rows = PYQS.filter(p=>{
    if(activePaper!=='All' && p.paper!==activePaper) return false;
    if(searchTerm){
      const hay = (p.question+' '+p.topic+' '+p.cluster).toLowerCase();
      if(!hay.includes(searchTerm)) return false;
    }
    return true;
  });
  const sortVal = document.getElementById('sortSel').value;
  rows = rows.slice().sort((a,b)=>{
    if(sortVal==='year-desc') return b.year-a.year;
    if(sortVal==='year-asc') return a.year-b.year;
    if(sortVal==='freq-desc') return clusterFreq[b.cluster]-clusterFreq[a.cluster];
    if(sortVal==='due-first'){
      const rank = {overdue:0,'due-today':1,scheduled:2,none:3};
      return rank[dueStatus(a)]-rank[dueStatus(b)];
    }
    return 0;
  });

  const listEl = document.getElementById('list');
  const emptyEl = document.getElementById('emptyState');
  if(rows.length===0){ listEl.innerHTML=''; emptyEl.style.display='block'; return; }
  emptyEl.style.display='none';

  listEl.innerHTML = rows.map(p=>{
    const col = PAPER_COLORS[p.paper]||'#888';
    const fl = freqLabel(p);
    const status = dueStatus(p);
    const stars = [1,2,3,4,5].map(n=>`<svg class="star ${n<=p.confidence?'filled':''}" data-star="${n}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4.5L6 21l1.5-7.5L2 9h7z"/></svg>`).join('');
    let revisionHtml = '';
    if(!p.attempted){
      revisionHtml = `<span style="color:var(--ink-300);">Mark attempted to start revision cycle</span>`;
    }else{
      const label = status==='overdue' ? `Overdue — was due ${p.nextDue}` : status==='due-today' ? 'Due today' : `Next revision: ${p.nextDue}`;
      revisionHtml = `<span class="${status==='overdue'?'overdue':status==='due-today'?'due-today':''}">${label}</span>
        <button class="revise-btn" data-revise="${p.id}">Mark Revised</button>`;
    }
    return `<div class="pcard" data-id="${p.id}">
      <div class="pcard-top">
        <div class="ptag" style="background:${col}1a;color:${col};">${p.paper}</div>
        <div class="yeartag">${p.year}</div>
        <div class="pq-main">
          <div class="pq-question serif">${p.question}</div>
          <div class="pq-meta">
            <span class="marks-badge">${p.marks} marks</span>
            <span>·</span>
            <span>${p.topic}</span>
            <span>·</span>
            <span>${p.cluster}</span>
            ${fl?`<span class="freq-badge">🔁 ${fl}</span>`:''}
          </div>
        </div>
      </div>
      <div class="pq-controls">
        <label class="attempt-toggle">
          <input type="checkbox" data-attempt="${p.id}" ${p.attempted?'checked':''}/>
          Attempted
        </label>
        <div class="stars" data-stars-for="${p.id}">${stars}</div>
        <div class="revision-info ${status}">${revisionHtml}</div>
      </div>
    </div>`;
  }).join('');

  listEl.querySelectorAll('[data-attempt]').forEach(el=>{
    el.addEventListener('change', ()=>{
      const p = PYQS.find(x=>x.id===el.dataset.attempt);
      p.attempted = el.checked;
      if(p.attempted && !p.confidence){ p.confidence = 3; }
      if(p.attempted){ p.lastRevised = todayStr(); p.nextDue = addDays(todayStr(), scheduleInterval(p.confidence)); }
      else { p.nextDue = null; p.confidence = 0; }
      render();
    });
  });
  listEl.querySelectorAll('[data-stars-for]').forEach(wrap=>{
    wrap.querySelectorAll('.star').forEach(star=>{
      star.addEventListener('click', ()=>{
        const p = PYQS.find(x=>x.id===wrap.dataset.starsFor);
        p.confidence = parseInt(star.dataset.star);
        if(p.attempted){ p.nextDue = addDays(p.lastRevised||todayStr(), scheduleInterval(p.confidence)); }
        render();
      });
    });
  });
  listEl.querySelectorAll('[data-revise]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const p = PYQS.find(x=>x.id===btn.dataset.revise);
      p.lastRevised = todayStr();
      p.nextDue = addDays(todayStr(), scheduleInterval(p.confidence));
      render();
    });
  });
}

function renderMiniStats(){
  const total = PYQS.length;
  const attempted = PYQS.filter(p=>p.attempted).length;
  const overdue = PYQS.filter(p=>dueStatus(p)==='overdue').length;
  const recurring = Object.values(clusterFreq).filter(n=>n>=3).length;
  document.getElementById('ministats').innerHTML = `
    <div class="ministat"><div class="mv">${total}</div><div class="ml">PYQs Tracked</div></div>
    <div class="ministat"><div class="mv">${attempted}/${total}</div><div class="ml">Attempted</div></div>
    <div class="ministat due"><div class="mv">${overdue}</div><div class="ml">Overdue for Revision</div></div>
    <div class="ministat"><div class="mv">${recurring}</div><div class="ml">High-Frequency Themes</div></div>
  `;
}

function renderDueStrip(){
  const due = PYQS.filter(p=> p.attempted && (dueStatus(p)==='overdue' || dueStatus(p)==='due-today'));
  document.getElementById('dueCount').textContent = due.length ? `${due.length} to revise` : '';
  const listEl = document.getElementById('dueList');
  if(due.length===0){
    listEl.innerHTML = `<div class="due-empty">Nothing due right now — mark answers as attempted below to start building your revision cycle.</div>`;
    return;
  }
  listEl.innerHTML = due.map(p=>`
    <div class="due-chip" data-jump="${p.id}"><span class="dpaper">${p.paper}</span>${p.topic}</div>
  `).join('');
  listEl.querySelectorAll('[data-jump]').forEach(chip=>{
    chip.addEventListener('click', ()=>{
      const el = document.querySelector(`.pcard[data-id="${chip.dataset.jump}"]`);
      if(el) el.scrollIntoView({behavior:'smooth', block:'center'});
    });
  });
}

render();
</script>
